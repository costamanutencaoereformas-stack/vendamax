{
    "version": 2,
    "functions": {
        "api/index.ts": {
            "runtime": "nodejs20.x",
            "memory": 1024,
            "maxDuration": 15
        }
    },
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/index.ts"
        },
        {
            "source": "/uploads/(.*)",
            "destination": "/api/index.ts"
        },
        {
            "source": "/((?!api/|uploads/|assets/|.*\\..*).*)",
            "destination": "/index.html"
        }
    ],
    "env": {
        "NODE_ENV": "production"
    }
}